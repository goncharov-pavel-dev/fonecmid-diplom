		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Услуга</dataPath>
			<field>Услуга</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ВКМ_ВыполненныеКлиентуРаботыОбороты.Клиент КАК Клиент,
	ВКМ_ВыполненныеКлиентуРаботыОбороты.Договор КАК Договор,
	ВКМ_ВыполненныеКлиентуРаботыОбороты.СуммаКОплатеОборот КАК СуммаКОплатеОборот
ПОМЕСТИТЬ ВТ_ВыполненныеКлиентуРаботы
ИЗ
	РегистрНакопления.ВКМ_ВыполненныеКлиентуРаботы.Обороты(, , , ) КАК ВКМ_ВыполненныеКлиентуРаботыОбороты

СГРУППИРОВАТЬ ПО
	ВКМ_ВыполненныеКлиентуРаботыОбороты.Клиент,
	ВКМ_ВыполненныеКлиентуРаботыОбороты.Договор,
	ВКМ_ВыполненныеКлиентуРаботыОбороты.СуммаКОплатеОборот
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВКМ_ВыставленныеУслугиОбороты.Контрагент КАК Контрагент,
	ВКМ_ВыставленныеУслугиОбороты.Договор КАК Договор,
	ВКМ_ВыставленныеУслугиОбороты.ВыставленнаяСуммаОборот КАК ВыставленнаяСуммаОборот
ПОМЕСТИТЬ ВТ_ВыставленнаяКонстанта
ИЗ
	РегистрНакопления.ВКМ_ВыставленныеУслуги.Обороты(, , , ) КАК ВКМ_ВыставленныеУслугиОбороты

СГРУППИРОВАТЬ ПО
	ВКМ_ВыставленныеУслугиОбороты.Контрагент,
	ВКМ_ВыставленныеУслугиОбороты.Договор,
	ВКМ_ВыставленныеУслугиОбороты.ВыставленнаяСуммаОборот
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ВыполненныеКлиентуРаботы.Клиент КАК Клиент,
	ВТ_ВыполненныеКлиентуРаботы.Договор КАК Договор,
	ВТ_ВыполненныеКлиентуРаботы.СуммаКОплатеОборот КАК СуммаКОплате,
	NULL КАК ВыставленнаяСумма
ИЗ
	ВТ_ВыполненныеКлиентуРаботы КАК ВТ_ВыполненныеКлиентуРаботы

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВТ_ВыставленнаяКонстанта.Контрагент,
	ВТ_ВыставленнаяКонстанта.Договор,
	NULL,
	ВТ_ВыставленнаяКонстанта.ВыставленнаяСуммаОборот
ИЗ
	ВТ_ВыставленнаяКонстанта КАК ВТ_ВыставленнаяКонстанта</query>
