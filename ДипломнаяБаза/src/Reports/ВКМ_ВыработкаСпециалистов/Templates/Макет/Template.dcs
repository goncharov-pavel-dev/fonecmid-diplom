		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ВКМ_ОсновныеНачисленияДанныеГрафика.Сотрудник,
	ВКМ_ОсновныеНачисленияДанныеГрафика.Результат,
	ВКМ_ОсновныеНачисленияДанныеГрафика.ОтработаноДней
ИЗ
	РегистрРасчета.ВКМ_ОсновныеНачисления.ДанныеГрафика(Сотрудник = &amp;Сотрудник) КАК ВКМ_ОсновныеНачисленияДанныеГрафика</query>
